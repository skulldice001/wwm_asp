@model LibraryArticle
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"]      = "New Article";
    ViewData["ActivePage"] = "library";
    var formModel = Model ?? new LibraryArticle { ContentFormat = "markdown" };
}

<div class="card card-outline card-primary">
    <div class="card-header">
        <h3 class="card-title"><i class="fas fa-plus mr-1"></i> New Article</h3>
        <div class="card-tools">
            <a href="/admin/library" class="btn btn-sm btn-secondary">
                <i class="fas fa-arrow-left mr-1"></i> Back
            </a>
        </div>
    </div>
    <form method="post" action="/admin/library/create">
        @Html.AntiForgeryToken()
        <div class="card-body">
            @await Html.PartialAsync("~/Views/Admin/Library/_Form.cshtml", formModel)
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save mr-1"></i> Create Draft
            </button>
        </div>
    </form>
</div>
