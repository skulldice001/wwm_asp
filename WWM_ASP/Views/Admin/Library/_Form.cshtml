@model LibraryArticle
@* Shared form partial used by Create and Edit *@

<div class="form-group">
    <label>Title <span class="text-danger">*</span></label>
    <input type="text" name="title" class="form-control" required maxlength="255"
           value="@Model.Title">
</div>

<div class="form-group">
    <label>Category <span class="text-danger">*</span></label>
    <select name="category" class="form-control" required>
        @foreach (var kv in LibraryArticle.Categories)
        {
            <option value="@kv.Key" selected="@(Model.Category == kv.Key ? "selected" : null)">@kv.Value</option>
        }
    </select>
</div>

<div class="form-group">
    <label>Excerpt <small class="text-muted">(optional short description)</small></label>
    <input type="text" name="excerpt" class="form-control" maxlength="500"
           value="@Model.Excerpt" placeholder="Short summary shown in listings...">
</div>

<div class="form-group">
    <label>Content <span class="text-danger">*</span></label>
    <input type="hidden" name="contentFormat" id="contentFormat"
           value="@(Model.ContentFormat ?? "markdown")">

    @if ((Model.ContentFormat ?? "markdown") == "markdown")
    {
        <textarea id="articleContent" name="content">@Model.Content</textarea>
    }
    else
    {
        <div class="mb-1 d-flex align-items-center" style="gap:8px;">
            <button type="button" class="btn btn-sm btn-outline-info" id="insertImgBtn">
                <i class="fas fa-image mr-1"></i> Insert Image
            </button>
            <input type="file" id="imgFileInput" accept="image/*" class="d-none">
            <span id="imgUploadStatus" class="text-muted small"></span>
        </div>
        <textarea id="articleContent" name="content" rows="22"
                  class="form-control"
                  style="font-family:monospace;font-size:13px;">@Model.Content</textarea>
        <small class="text-muted">HTML / plain text mode. Images can be inserted via the button above.</small>
    }
</div>

@section Scripts {
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/easymde/dist/easymde.min.css">
<script src="https://cdn.jsdelivr.net/npm/easymde/dist/easymde.min.js"></script>
<script>
(function () {
    var fmt = document.getElementById('contentFormat').value;

    if (fmt === 'markdown') {
        (function waitForMDE() {
            if (typeof EasyMDE === 'undefined') return setTimeout(waitForMDE, 50);
            new EasyMDE({
                element: document.getElementById('articleContent'),
                spellChecker: false,
                autosave: { enabled: false },
                uploadImage: true,
                imageUploadFunction: function (file, onSuccess, onError) {
                    var form = new FormData();
                    form.append('image', file);
                    form.append('__RequestVerificationToken',
                        document.querySelector('input[name="__RequestVerificationToken"]').value);
                    fetch('/admin/library/upload-image', { method: 'POST', body: form })
                        .then(function (r) { return r.json(); })
                        .then(function (d) { if (d.url) onSuccess(d.url); else onError('Upload failed'); })
                        .catch(function () { onError('Upload error'); });
                },
                toolbar: ['bold','italic','heading','|','quote','unordered-list','ordered-list','|',
                          'link','upload-image','|','preview','side-by-side','fullscreen','|','guide'],
                minHeight: '420px',
            });
        })();
    } else {
        var btn    = document.getElementById('insertImgBtn');
        var input  = document.getElementById('imgFileInput');
        var status = document.getElementById('imgUploadStatus');
        var ta     = document.getElementById('articleContent');

        if (btn) {
            btn.addEventListener('click', function () { input.click(); });
            input.addEventListener('change', async function () {
                var file = input.files[0];
                if (!file) return;
                status.textContent = 'Uploading...';
                btn.disabled = true;
                var form = new FormData();
                form.append('image', file);
                form.append('__RequestVerificationToken',
                    document.querySelector('input[name="__RequestVerificationToken"]').value);
                try {
                    var res  = await fetch('/admin/library/upload-image', { method: 'POST', body: form });
                    var data = await res.json();
                    if (data.url) {
                        var tag   = '<img src="' + data.url + '" style="max-width:100%;border-radius:6px;margin:8px 0;" alt="">';
                        var start = ta.selectionStart;
                        ta.value  = ta.value.slice(0, start) + tag + ta.value.slice(ta.selectionEnd);
                        ta.selectionStart = ta.selectionEnd = start + tag.length;
                        ta.focus();
                        status.textContent = 'Inserted.';
                    } else {
                        status.textContent = 'Upload failed.';
                    }
                } catch (e) {
                    status.textContent = 'Upload error.';
                } finally {
                    btn.disabled = false;
                    input.value  = '';
                    setTimeout(function () { status.textContent = ''; }, 3000);
                }
            });
        }
    }
})();
</script>
}
