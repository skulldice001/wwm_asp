@model LibraryArticle
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"]      = $"Edit: {Model.Title}";
    ViewData["ActivePage"] = "library";
}

<div class="card card-outline card-primary">
    <div class="card-header d-flex align-items-center">
        <h3 class="card-title"><i class="fas fa-edit mr-1"></i> Edit Article</h3>
        <div class="ml-auto d-flex" style="gap:6px;">
            @if (Model.IsPublished)
            {
                <form method="post" action="/admin/library/@Model.Id/unpublish" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-warning btn-sm">
                        <i class="fas fa-eye-slash mr-1"></i> Unpublish
                    </button>
                </form>
            }
            else
            {
                <form method="post" action="/admin/library/@Model.Id/publish" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-success btn-sm">
                        <i class="fas fa-check mr-1"></i> Publish
                    </button>
                </form>
            }
            <a href="/library/@Model.Category/@Model.Id" target="_blank"
               class="btn btn-sm btn-outline-secondary">
                <i class="fas fa-external-link-alt mr-1"></i> View
            </a>
            <a href="/admin/library" class="btn btn-sm btn-secondary">
                <i class="fas fa-arrow-left mr-1"></i> Back
            </a>
        </div>
    </div>
    <form method="post" action="/admin/library/@Model.Id/edit">
        @Html.AntiForgeryToken()
        <div class="card-body">
            <div class="mb-2">
                @if (Model.IsPublished)
                {
                    <span class="badge badge-success">Published</span>
                }
                else
                {
                    <span class="badge badge-warning">Draft</span>
                }
                @if (!string.IsNullOrEmpty(Model.DiscordMessageId))
                {
                    <span class="badge badge-secondary ml-1">
                        <i class="fab fa-discord mr-1"></i>Discord import
                    </span>
                }
                <small class="text-muted ml-2">
                    Created: @Model.CreatedAt?.ToString("dd/MM/yyyy HH:mm")
                </small>
            </div>
            @await Html.PartialAsync("~/Views/Admin/Library/_Form.cshtml", Model)
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save mr-1"></i> Save Changes
            </button>
        </div>
    </form>
</div>
