@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"]      = "Create User";
    ViewData["ActivePage"] = "users";
}

<div class="card card-outline card-primary" style="max-width:600px;">
    <div class="card-header">
        <h3 class="card-title"><i class="fas fa-user-plus mr-1"></i> Create User</h3>
    </div>
    <form method="post" action="/admin/users/create">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="card-body pb-0 text-danger"></div>
        <div class="card-body">
            <div class="form-group">
                <label>Account <span class="text-danger">*</span></label>
                <input type="text" name="account" class="form-control" required maxlength="255">
            </div>
            <div class="form-group">
                <label>Display name</label>
                <input type="text" name="name" class="form-control" maxlength="255">
            </div>
            <div class="form-group">
                <label>Email</label>
                <input type="email" name="email" class="form-control" maxlength="255">
            </div>
            <div class="form-row">
                <div class="form-group col-md-6">
                    <label>Password <span class="text-danger">*</span></label>
                    <input type="password" name="password" class="form-control" required>
                </div>
                <div class="form-group col-md-6">
                    <label>Confirm password <span class="text-danger">*</span></label>
                    <input type="password" name="passwordConfirm" class="form-control" required>
                </div>
            </div>
            <div class="form-group">
                <label>In-game name</label>
                <input type="text" name="ingameName" class="form-control" maxlength="255">
            </div>
            <div class="form-group">
                <label>Country</label>
                <input type="text" name="country" class="form-control" maxlength="255">
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save mr-1"></i> Create
            </button>
            <a href="/admin/users" class="btn btn-secondary ml-2">Cancel</a>
        </div>
    </form>
</div>
